@model WorkMate.ViewModels.TasksCombinedViewModel
@{
    ViewBag.Title = "Index";
}

<div class="container-fluid">
    <div class="card">
        <div class="card-header">
            <div class="d-flex justify-content-between align-items-center">
                <div class="card-title">
                    <h3>Task Overview</h3>
                </div>
                <button type="button" class="btn btn-primary  px-4 py-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#createTaskModal">
                    <i class="fa fa-plus-circle"></i> Create New Task
                </button>
            </div>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-6">
                    <h3 class="text-primary">Selected Task Details</h3>
                    @if (Model.SelectedTask != null)
                    {
                        using (Html.BeginForm("SaveChanges", "Task", FormMethod.Post, new { @class = "bg-light shadow-sm border border-light" }))
                        {
                            @Html.AntiForgeryToken()
                            @Html.HiddenFor(m => m.SelectedTask.TaskId)

                            <div class="mb-3">
                                <div class="form-floating">
                                    @Html.EditorFor(m => m.SelectedTask.TaskName, new { htmlAttributes = new { @class = "form-control", placeholder = "Task Name", id = "selectedTaskName" } })
                                    @Html.LabelFor(m => m.SelectedTask.TaskName, "Task Name", new { @for = "selectedTaskName" })
                                    @Html.ValidationMessageFor(m => m.SelectedTask.TaskName, "", new { @class = "text-danger small mt-1" })
                                </div>
                            </div>
                            <div class="mb-3">
                                <div class="form-floating">
                                    @Html.EditorFor(m => m.SelectedTask.TaskDescription, new { htmlAttributes = new { @class = "form-control", placeholder = "Task Description", rows = "5", style = "height: 120px;", id = "selectedTaskDescription" } })
                                    @Html.LabelFor(m => m.SelectedTask.TaskDescription, "Task Description", new { @for = "selectedTaskDescription" })
                                    @Html.ValidationMessageFor(m => m.SelectedTask.TaskDescription, "", new { @class = "text-danger small mt-1" })
                                </div>
                            </div>
                            <div class="row mt-4">
                                <div class="col-3">
                                    <button type="submit" class="btn btn-success">
                                        <i class="fa fa-save me-2"></i> Save Changes
                                    </button>
                                </div>
                                <div class="col-3">
                                    <button type="button" class="btn btn-danger" id="btnShowDeleteModal" onclick="showDeleteModal()">
                                        <i class="fa fa-trash me-2"></i>Delete task
                                    </button>
                                </div>

                            </div>
                        }
                    }
                </div>
                <div class="col-6">
                    <div class="bg-light h-100 shadow-sm">
                        <h3 class="text-primary mb-3">All Available Tasks</h3>
                        <div class="table-responsive">
                            <table class="table table-hover table-striped table-bordered overflow-hidden">
                                <thead class="table-dark">
                                    <tr>
                                        <th scope="col">ID</th>
                                        <th scope="col">Task Name</th>
                                        <th scope="col">Task Description</th>
                                        <th scope="col">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.AllTaskList != null && Model.AllTaskList.Any())
                                    {
                                        foreach (var task in Model.AllTaskList)
                                        {
                                            <tr class="@(Model.SelectedTask != null && Model.SelectedTask.TaskId == task.TaskId ? "table-primary" : "")">
                                                <td>
                                                    <p>@task.TaskId</p>
                                                </td>
                                                <td>
                                                    <p>@task.TaskName</p>
                                                </td>
                                                <td>
                                                    <p>@task.TaskDescription</p>
                                                </td>
                                                <td>
                                                    <a href="@Url.Action("Index", "Task", new { selectedId = task.TaskId })" class="btn btn-sm btn-outline-primary">
                                                        <i class="fa fa-eye"></i>
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Create Task Modal -->
<div class="modal fade" id="createTaskModal" tabindex="-1" aria-labelledby="createTaskModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        @using (Html.BeginForm("Create", "Task", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <div class="modal-content shadow">
                <div class="modal-header bg-info text-white">
                    <h5 class="modal-title" id="createTaskModalLabel">Create New Task</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">


                    <div class="row">
                        <div class="col-12">
                            <div class="form-floating">
                                @Html.EditorFor(m => m.SelectedTask.TaskName, new { htmlAttributes = new { @class = "form-control", placeholder = "Task Name" } })
                                @Html.LabelFor(m => m.SelectedTask.TaskName)
                                @Html.ValidationMessageFor(m => m.SelectedTask.TaskName, "", new { @class = "text-danger small" })
                            </div>
                        </div>
                    </div>
                    <div class="row"><div class="col-12">&nbsp;</div></div>
                    <div class="row">

                        <div class="col-12">
                            <div class="form-floating">
                                @Html.EditorFor(m => m.SelectedTask.TaskDescription, new { htmlAttributes = new { @class = "form-control", placeholder = "Actual Result" } })
                                @Html.LabelFor(m => m.SelectedTask.TaskDescription)
                                @Html.ValidationMessageFor(m => m.SelectedTask.TaskDescription, "", new { @class = "text-danger small" })
                            </div>
                        </div>

                    </div>


                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4">
                        Create new task
                    </button>
                </div>

            </div>

        }

    </div>
</div>
<!--Delete confirmation modal-->
<div class="modal fade" id="deleteConfirmationModal" tabindex="-1" aria-labelledby="deleteConfirmationModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content shadow-lg">
            <div class="modal-header bg-danger text-white ">
                <h5 class="modal-title" id="deleteConfirmationModalLabel">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> Confirm Deletion
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <p class="lead mb-3">Are you sure you want to delete Task: <strong id="itemToDeleteNamePlaceholder">@Model.SelectedTask.TaskName</strong>?</p>
                <p class="text-danger">This action cannot be undone.</p>
                @Html.HiddenFor(m => Model.SelectedTask.TaskId)
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary  px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger px-4" id="confirmDeleteButton">
                    <i class="bi bi-trash-fill me-2"></i> Delete
                </button>
            </div>
        </div>
    </div>
</div>


@section scripts{
    <script src="~/Scripts/Task.js"></script>
}

