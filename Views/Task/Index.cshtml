@model WorkMate.ViewModels.TasksCombinedViewModel
@{
    ViewBag.Title = "Index";
}

<div class="container-fluid">
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center bg-primary text-white">
            <h4>Task Overview</h4>
            <button type="button" class="btn btn-dark  px-4 py-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#createTaskModal">
                <i class="fa fa-plus-circle mx-2"></i> Create New Task
            </button>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-6 shadow-sm">
                    <h3 class="text-primary">Selected Task Details</h3>
                    @if (Model.SelectedTask != null)
                    {
                        using (Html.BeginForm("SaveChanges", "Task", FormMethod.Post, new { @class = "" }))
                        {
                            @Html.AntiForgeryToken()
                            @Html.HiddenFor(m => m.SelectedTask.TaskId)

                            <div class="mb-3">
                                <div class="form-floating">
                                    @Html.EditorFor(m => m.SelectedTask.TaskName, new { htmlAttributes = new { @class = "form-control", placeholder = "Task Name", id = "selectedTaskName" } })
                                    @Html.LabelFor(m => m.SelectedTask.TaskName, "Task Name", new { @for = "selectedTaskName" })
                                    @Html.ValidationMessageFor(m => m.SelectedTask.TaskName, "", new { @class = "text-danger small mt-1" })
                                </div>
                            </div>
                            <div class="mb-3">
                                <div class="form-floating">
                                    @Html.TextAreaFor(m => m.SelectedTask.TaskDescription, new { @class = "form-control", placeholder = "Task Description" })
                                    @Html.LabelFor(m => m.SelectedTask.TaskDescription, "Task Description", new { @for = "SelectedTask_TaskDescription" })
                                    @Html.ValidationMessageFor(m => m.SelectedTask.TaskDescription, "", new { @class = "text-danger small mt-1" })
                                </div>
                            </div>
                            <div class="row mt-4 mb-1">
                                <div class="col-12">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <button type="submit" class="btn btn-success">
                                            <i class="fa fa-save me-2"></i> Save changes
                                        </button>
                                        <button type="button" class="btn btn-danger" id="btnShowDeleteModal" onclick="showDeleteModal()">
                                            <i class="fa fa-trash me-2"></i>Delete task
                                        </button>
                                    </div>
                                </div>


                            </div>
                        }
                    }
                    else
                    {
                        <div class="row">
                            <div class="col-12">
                                <p class="alert alert-warning">No task to select. </p>
                            </div>
                        </div>
                    }
                </div>
                
                <div class="col-6">
                    <div class="">
                        @using (Html.BeginForm("index", "Task", FormMethod.Post, new { id = "searchForm", @class = "" }))
                        {
                            <div class="row justify-content-between align-items-center">
                                <div class="col-4">
                                    <h3 class="text-primary mb-3 my-2">Task List</h3>
                                </div>
                                <div class="col-8">
                                    <div class="input-group">
                                        <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" id="searchTypeButton" name="searchType">
                                            Exact Search
                                        </button>

                                        <ul class="dropdown-menu">
                                            <li><a class="dropdown-item search-option" href="#" data-search-type="exact">Exact Search</a></li>
                                            <li><a class="dropdown-item search-option" href="#" data-search-type="partial">Partial Match</a></li>
                                            <li><a class="dropdown-item search-option" href="#" data-search-type="prefix">Prefix Match</a></li>
                                            <li><a class="dropdown-item search-option" href="#" data-search-type="fuzzy">Fuzzy Match</a></li>
                                        </ul>

                                        <input type="search" class="form-control" placeholder="Search by task name" aria-label="Search" id="searchString" name="searchString" />

                                        <button class="btn btn-success" type="submit" id="btnSearchTask">
                                            <i class="fa fa-search"></i>
                                        </button>&nbsp;
                                        <button class="btn btn-warning" type="submit" id="btnRefreshSearch">
                                            <i class="fa fa-refresh"></i>
                                        </button>
                                        @Html.Hidden("searchType", "exact", new { id = "hdnSearchType" })
                                    </div>
                                </div>
                            </div>

                        }


                        <div class="table-responsive  slim-scrollbar">
                            <table class="table table-hover table-striped overflow-hidden">
                                <thead class="table-dark">
                                    <tr>
                                        <th scope="col">ID</th>
                                        <th scope="col">Task Name</th>
                                        <th scope="col">Task Description</th>
                                        <th scope="col">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.AllTaskList != null && Model.AllTaskList.Any())
                                    {
                                        foreach (var task in Model.AllTaskList)
                                        {
                                            <tr class="@(Model.SelectedTask != null && Model.SelectedTask.TaskId == task.TaskId ? "table-primary" : "")">
                                                <td>
                                                    <p>@task.TaskId</p>
                                                </td>
                                                <td>
                                                    <p>@task.TaskName</p>
                                                </td>
                                                <td>
                                                    <p>@task.TaskDescription</p>
                                                </td>
                                                <td>
                                                    <a href="@Url.Action("Index", "Task", new { selectedId = task.TaskId })" class="btn btn-sm btn-outline-primary">
                                                        <i class="fa fa-eye"></i>
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr class="text-warning text-center">
                                            <td colspan="4"><i class="fa fa-warning mx-2"></i>No data found.</td>
                                        </tr>
                                    }

                                </tbody>
                            </table>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Create Task Modal -->
<div class="modal fade" id="createTaskModal" tabindex="-1" aria-labelledby="createTaskModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog">
        @using (Html.BeginForm("Create", "Task", FormMethod.Post, new { id = "createTaskForm", @class = "" }))
        {
            @Html.AntiForgeryToken()
            <div class="modal-content shadow">
                <div class="modal-header bg-info text-white">
                    <h5 class="modal-title" id="createTaskModalLabel">Create New Task</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">


                    <div class="row">
                        <div class="col-12">
                            <div class="form-floating">
                                @Html.EditorFor(m => m.NewTask.TaskName, new { htmlAttributes = new { @class = "form-control", placeholder = "Task Name" } })
                                @Html.LabelFor(m => m.NewTask.TaskName)
                                <p class="text-danger d-none" id="errmsgMdlTaskName"><b>Please provide correct taskname, taskname should atleast contains 3 letters.</b></p>
                            </div>
                        </div>
                    </div>
                    <div class="row"><div class="col-12">&nbsp;</div></div>
                    <div class="row">

                        <div class="col-12">
                            <div class="form-floating">
                                @Html.TextAreaFor(m => m.NewTask.TaskDescription, new { @class = "form-control", placeholder = "Task Description" })
                                @Html.LabelFor(m => m.NewTask.TaskDescription, "Task Description")
                                <p class="text-danger d-none" id="errmsgMdlTaskDescription"><b>Please provide correct task description, task description should atleast contains 3 letters.</b></p>
                            </div>
                        </div>

                    </div>


                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4" id="btnCreateNewTask">
                        Create new task
                    </button>
                </div>

            </div>

        }

    </div>
</div>
<!--Delete confirmation modal-->
<div class="modal fade" id="deleteConfirmationModal" tabindex="-1" aria-labelledby="deleteConfirmationModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content shadow-lg">
            <div class="modal-header bg-danger text-white ">
                <h5 class="modal-title" id="deleteConfirmationModalLabel">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> Confirm Deletion
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            @using (Html.BeginForm("Delete", "Task", FormMethod.Post, new { @class = "" }))
            {
                @Html.AntiForgeryToken()
                if (Model.SelectedTask != null)
                {
                    <div class="modal-body text-center">
                        <p class="lead mb-3">Are you sure you want to delete Task: <strong id="itemToDeleteNamePlaceholder">@Model.SelectedTask.TaskName</strong>?</p>
                        <p class="text-danger">This action cannot be undone.</p>
                        @Html.Hidden("taskId", WorkMate.Helpers.Encryptor.EncryptUrlSafe(Model.SelectedTask.TaskId.ToString()))

                    </div>
                }

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary  px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger px-4" id="confirmDeleteButton">
                        <i class="bi bi-trash-fill me-2"></i> Delete
                    </button>
                </div>

            }

        </div>
    </div>
</div>


@section scripts{
    <script src="~/Scripts/Task.js"></script>
}

