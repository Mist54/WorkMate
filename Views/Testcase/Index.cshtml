@model WorkMate.ViewModels.TestIndexViewModal
@{
    ViewBag.Title = "Index";
}
<div class="bg-light rounded rounded-1">
    <div class="">
        <div class="d-flex justify-content-end">
            <div class="">
                <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#downloadModal">
                    <i class="fa fa-download"></i> Download Testcases
                </button>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-3">
        <div class="card shadow-lg rounded-3 border-0">
            <div class="card-body text-center text-white rounded-3" style="background: linear-gradient(135deg, #ff512f, #dd2476); position: relative; overflow: hidden; transition: transform 0.3s;">
                <div class="mb-2">
                    <i class="fa fa-tasks fa-3x"></i>
                </div>
                <h5 class="card-title mb-1">Testcase Count</h5>
                <h2 class="fw-bold animate-hover">@Model.TestCaseCount</h2>
                
            </div>
        </div>
    </div>
    <div class="col-3">
        <div class="card shadow-lg rounded-3 border-0">
            <div class="card-body text-center text-white rounded-3" style="background: linear-gradient(135deg, #11998e, #38ef7d); position: relative; overflow: hidden; transition: transform 0.3s;">
                <div class="mb-2">
                    <i class="fa fa-clipboard fa-3x"></i>
                </div>
                <h5 class="card-title mb-1">Task Count</h5>
                <h2 class="fw-bold animate-hover">@Model.TaskCount</h2>
               
            </div>
        </div>
    </div>
</div>





@*Download Testcase file*@
<div class="modal fade" id="downloadModal" tabindex="-1" aria-labelledby="downloadModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="downloadModalLabel">Download Testcase</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- Form inside modal -->
            @using (Html.BeginForm("DownloadTestcase", "Testcase", FormMethod.Post, new { @id = "downloadForm" }))
            {
                <div class="modal-body">
                    <div class="col-md-12">
                        @Html.LabelFor(model => model.Tasks, "Task", new { @class = "form-label" })
                        @{
                            var ddlTasks = Model.ddlTaskList ?? Enumerable.Empty<SelectListItem>();
                        }
                        @Html.DropDownListFor(
                            model => model.SelectedTaskId,
                            ddlTasks,
                            new { @class = "form-control  select2", id = "ddlTaskModalDownload" }
                        )
                        @Html.ValidationMessageFor(model => model.SelectedTaskId, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Download</button>
                </div>
            }

        </div>
    </div>
</div>

@section Scripts {
    <script>

    var createPartialUrl = '@Url.Action("CreatePartial", "Testcase")';
    </script>
    <script src="~/Scripts/Testcase.js"></script>


}