@model WorkMate.ViewModels.DashboardViewModel

<div class="container-fluid p-3">

    <!-- Summary Cards Row -->
    <div class="row g-2 mb-4">
        <div class="col-md-2 col-sm-6">
            <div class="card border-0 shadow-sm text-center">
                <div class="card-body p-3">
                    <h6 class="text-muted mb-2">Total Tasks</h6>
                    <h3 class="text-primary mb-0">@Model.TotalTasks</h3>
                </div>
            </div>
        </div>
        <div class="col-md-2 col-sm-6">
            <div class="card border-0 shadow-sm text-center">
                <div class="card-body p-3">
                    <h6 class="text-muted mb-2">Open</h6>
                    <h3 class="text-success mb-0">@Model.OpenTasks</h3>
                </div>
            </div>
        </div>
        <div class="col-md-2 col-sm-6">
            <div class="card border-0 shadow-sm text-center">
                <div class="card-body p-3">
                    <h6 class="text-muted mb-2">In Progress</h6>
                    <h3 class="text-info mb-0">@Model.InProgressTasks</h3>
                </div>
            </div>
        </div>
        <div class="col-md-2 col-sm-6">
            <div class="card border-0 shadow-sm text-center">
                <div class="card-body p-3">
                    <h6 class="text-muted mb-2">QA Testing</h6>
                    <h3 class="text-warning mb-0">@Model.QATasks</h3>
                </div>
            </div>
        </div>
        <div class="col-md-2 col-sm-6">
            <div class="card border-0 shadow-sm text-center">
                <div class="card-body p-3">
                    <h6 class="text-muted mb-2">Completed</h6>
                    <h3 class="text-success mb-0">@Model.CompletedTasks</h3>
                </div>
            </div>
        </div>
        <div class="col-md-2 col-sm-6">
            <div class="card border-0 shadow-sm text-center">
                <div class="card-body p-3">
                    <h6 class="text-muted mb-2">Blocked</h6>
                    <h3 class="text-danger mb-0">@Model.BlockedTasks</h3>
                </div>
            </div>
        </div>
    </div>
    <!-- Task Lists Accordion -->
    <div class="row mb-4">
        <div class="col-lg-12">
            <h6 class="mb-2">Task Lists</h6>
            <div class="accordion" id="taskAccordion">

                <!-- In Progress / Other Tasks -->
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOther">
                            In Progress / Other Tasks (@Model.RecentTasks.Where(t => t.Status != "QA" && t.Status != "Completed").Count())
                        </button>
                    </h2>
                    <div id="collapseOther" class="accordion-collapse collapse show" data-bs-parent="#taskAccordion">
                        <div class="accordion-body p-2">
                            @if (!Model.RecentTasks.Any(t => t.Status != "QA" && t.Status != "Completed"))
                            {
                                <p class="text-muted mb-0">No other tasks found.</p>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-sm table-striped mb-0">
                                        <thead class="table-warning">
                                            <tr>
                                                <th>Task</th>
                                                <th>Assigned To</th>
                                                <th>Status</th>
                                                <th>Priority</th>
                                                <th>Created</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var task in Model.RecentTasks.Where(t => t.Status != "QA" && t.Status != "Completed"))
                                            {
                                                <tr>
                                                    <td>@task.TaskName</td>
                                                    <td>@task.AssignedTo</td>
                                                    <td><span class="badge bg-info">@task.Status</span></td>
                                                    <td>@task.Priority</td>
                                                    <td>@task.CreatedDate.ToShortDateString()</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- QA Sent Tasks -->
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseQA">
                            QA Sent Tasks (@Model.RecentTasks.Count(t => t.Status == "QA"))
                        </button>
                    </h2>
                    <div id="collapseQA" class="accordion-collapse collapse" data-bs-parent="#taskAccordion">
                        <div class="accordion-body p-2">
                            @if (!Model.RecentTasks.Any(t => t.Status == "QA"))
                            {
                                <p class="text-muted mb-0">No QA tasks found.</p>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-sm table-striped mb-0">
                                        <thead class="table-info">
                                            <tr>
                                                <th>Task</th>
                                                <th>Assigned To</th>
                                                <th>Status</th>
                                                <th>Priority</th>
                                                <th>Created</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var task in Model.RecentTasks.Where(t => t.Status == "QA"))
                                            {
                                                <tr>
                                                    <td>@task.TaskName</td>
                                                    <td>@task.AssignedTo</td>
                                                    <td><span class="badge bg-warning">@task.Status</span></td>
                                                    <td>@task.Priority</td>
                                                    <td>@task.CreatedDate.ToShortDateString()</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Completed Tasks -->
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseCompleted">
                            Completed Tasks (@Model.RecentTasks.Count(t => t.Status == "Completed"))
                        </button>
                    </h2>
                    <div id="collapseCompleted" class="accordion-collapse collapse" data-bs-parent="#taskAccordion">
                        <div class="accordion-body p-2">
                            @if (!Model.RecentTasks.Any(t => t.Status == "Completed"))
                            {
                                <p class="text-muted mb-0">No completed tasks found.</p>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-sm table-striped mb-0">
                                        <thead class="table-success">
                                            <tr>
                                                <th>Task</th>
                                                <th>Assigned To</th>
                                                <th>Status</th>
                                                <th>Priority</th>
                                                <th>Created</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var task in Model.RecentTasks.Where(t => t.Status == "Completed"))
                                            {
                                                <tr>
                                                    <td>@task.TaskName</td>
                                                    <td>@task.AssignedTo</td>
                                                    <td><span class="badge bg-success">@task.Status</span></td>
                                                    <td>@task.Priority</td>
                                                    <td>@task.CreatedDate.ToShortDateString()</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
    <!-- Charts Row -->
    <div class="row g-3 mb-4">
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom">
                    <h6 class="mb-0">Tasks by Status</h6>
                </div>
                <div class="card-body p-2">
                    <canvas id="statusChart" height="180"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom">
                    <h6 class="mb-0">Tasks per User</h6>
                </div>
                <div class="card-body p-2">
                    <canvas id="usersChart" height="180"></canvas>
                </div>
            </div>
        </div>
    </div>


</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>
    <script>
        // Status Chart
        var statusCtx = document.getElementById('statusChart');
        if (statusCtx) {
            new Chart(statusCtx, {
                type: 'doughnut',
                data: {
                    labels: [@Html.Raw(string.Join(",", Model.TasksByStatus.Keys.Select(k => "'" + k + "'")))],
                    datasets: [{
                        data: [@Html.Raw(string.Join(",", Model.TasksByStatus.Values))],
                        backgroundColor: ['#28a745', '#17a2b8', '#ffc107', '#20c997', '#dc3545'],
                        borderColor: '#fff',
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    plugins: {
                        legend: { position: 'bottom' }
                    }
                }
            });
        }

        // Users Chart
        var usersCtx = document.getElementById('usersChart');
        if (usersCtx && @Html.Raw(Model.TasksPerUser.Count > 0 ? "true" : "false")) {
            new Chart(usersCtx, {
                type: 'bar',
                data: {
                    labels: [@Html.Raw(string.Join(",", Model.TasksPerUser.Keys.Select(k => "'" + k + "'")))],
                    datasets: [{
                        label: 'Tasks',
                        data: [@Html.Raw(string.Join(",", Model.TasksPerUser.Values))],
                        backgroundColor: '#36A2EB',
                        borderColor: '#2e7db2',
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    indexAxis: 'y',
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { beginAtZero: true, ticks: { stepSize: 1 } }
                    }
                }
            });
        }
    </script>
}