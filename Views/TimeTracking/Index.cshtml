@model WorkMate.ViewModels.TimeTrackingListViewModel
@{
    ViewBag.Title = "Time Tracking";
}
<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-md-12">
          
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center bg-dark">
                    <h3 class="my-0 text-white">Time Tracking</h3>
                    <div>
                        <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#downloadModal">
                            <i class="fa fa-download mx-2"></i>Download Report
                        </button>
                        <button type="button" class="btn btn-info" data-bs-toggle="modal" data-bs-target="#createModal">
                            <i class="fa fa-plus-circle mx-2"></i>Create New Time Track
                        </button>
                    </div>
                </div>
                <div class="card shadow-sm p-3">
                    <div class="card-header border-0 pb-0 bg-white">
                    </div>
                    <!--InProgess Set of timetracks-->
                    <div class="card-body pt-0">
                        @if (Model.TaskTimeEntries != null && Model.TaskTimeEntries.Any())
                        {
                            foreach (var item in Model.TaskTimeEntries.Where(t => t.Status != WorkMate.Models.TaskStatus.Completed))
                            {
                                using (Html.BeginForm("UpdateTimeTrack", "TimeTracking", FormMethod.Post, new { @class = "time-track-form row align-items-center mb-2 p-2 border rounded bg-light gx-2" }))

                                {
                                    @Html.AntiForgeryToken()
                                    @Html.Hidden("Id", item.Id)
                                    <!-- Description -->
                                    <div class="col-lg-4 col-12">
                                        @Html.TextAreaFor(m => item.Description, new { @class = "form-control form-control-sm bg-white text-muted", @readonly = "readonly", rows = 1 })
                                        @Html.HiddenFor(m => item.Id)
                                    </div>

                                    <!-- Status -->
                                    <div class="col-lg-2 col-6 mt-1 mt-lg-0">
                                        @Html.TextBoxFor(m => item.Status, new { @class = "form-control form-control-sm bg-white text-muted", @readonly = "readonly", id = "displayStatus_" + item.Id })
                                        @Html.HiddenFor(m => item.Status)
                                    </div>

                                    <!-- Task Name -->
                                    <div class="col-lg-3 col-6 mt-1 mt-lg-0">
                                        @Html.TextBoxFor(m => item.TaskName, new { @class = "form-control form-control-sm bg-white text-muted", @readonly = "readonly", id = "displayTask_" + item.Id })
                                        @Html.HiddenFor(m => item.TaskId)
                                    </div>

                                    <!-- Timer & Actions -->
                                    <div class="col-lg-3 col-12 d-flex flex-column flex-sm-row align-items-center justify-content-between mt-1 mt-lg-0">
                                        <!-- Timer -->
                                        @{
                                            TimeSpan duration = TimeSpan.Zero;
                                            if (item.StartDate != null)
                                            {
                                                var endTime = item.EndDate ?? DateTime.Now; // If EndDate is null, use current time
                                                duration = endTime - item.StartDate;
                                            }
                                        }
                                        <p class="badge bg-light text-primary text-monospace px-2 py-1 mb-1 mb-sm-0"
                                           id="Timer_@item.Id"
                                           data-seconds="@((int)duration.TotalSeconds)">
                                            @duration.ToString(@"hh\:mm\:ss")
                                        </p>
                                        <!-- Action Buttons -->
                                        <div class="d-flex gap-1">
                                            <button type="submit" name="action" value="Start" class="btn btn-warning btn-sm flex-fill">Start</button>
                                            <button type="submit" name="action" value="Stop" class="btn btn-danger btn-sm d-none flex-fill">Stop</button>
                                            <button type="submit" name="action" value="Delete" class="btn btn-outline-danger btn-sm flex-fill"><i class="fa fa-trash"></i></button>
                                            @if (item.Status.ToString() != "Complete")
                                            {
                                                <button type="submit" name="action" value="Complete" class="btn btn-info btn-sm flex-fill">Complete</button>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                        }
                        else
                        {
                            <h6 class="alert alert-warning text-center">No time records. Create new</h6>
                        }
                    </div>
                    <!--Completed Set of timetracks-->
                    <div id="CompletedTaskContainer">
                        @Html.Partial("~/Views/Shared/TimeTrack/_TimeTrackCompletedTask.cshtml", Model)
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- Create Modal -->
<div class="modal fade" id="createModal" tabindex="-1" aria-labelledby="createModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="createModalLabel"><i class="fa fa-plus-circle me-2"></i>Add New Track</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            @using (Html.BeginForm("Create", "TimeTracking", FormMethod.Post, new { id = "timeTrackingForm" }))
            {
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="alert alert-info" role="alert">
                        <i class="fa fa-info-circle me-2"></i>Fields marked with an asterisk (*) are required.
                    </div>
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                    @Html.HiddenFor(model => model.NewRecord.Id)
                    @Html.HiddenFor(model => model.NewRecord.UserId)
                    @Html.HiddenFor(model => model.NewRecord.TaskName)

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="form-group">
                                @Html.LabelFor(model => model.NewRecord.TaskId, new { @class = "form-label" })*
                                @Html.DropDownListFor(model => model.NewRecord.TaskId, Model.DdlTasks, new { @class = " form-select select2" })
                                @Html.ValidationMessageFor(model => model.NewRecord.TaskId, "", new { @class = "text-danger" })
                                <div id="taskError" class="invalid-feedback" style="display:none;"></div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                @Html.LabelFor(model => model.NewRecord.Status, new { @class = "form-label" })*
                                @Html.EnumDropDownListFor(model => model.NewRecord.Status, new { @class = "form-select select2" })
                                @Html.ValidationMessageFor(model => model.NewRecord.Status, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-12">
                            <div class="form-group">
                                @Html.LabelFor(model => model.NewRecord.Description, new { @class = "form-label" })*
                                @Html.TextAreaFor(model => model.NewRecord.Description, new { @class = "form-control", rows = 4, placeholder = "Describe your work here..." })
                                @Html.ValidationMessageFor(model => model.NewRecord.Description, "", new { @class = "text-danger" })
                                <div class="invalid-feedback" id="descError"></div>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="form-group">
                                @Html.LabelFor(model => model.NewRecord.StartDate, new { @class = "form-label" })*
                                @Html.TextBoxFor(model => model.NewRecord.StartDate, "{0:yyyy-MM-ddTHH:mm}", new { @type = "datetime-local", @class = "form-control flatpickr-datetime" })
                                @Html.ValidationMessageFor(model => model.NewRecord.StartDate, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                @Html.LabelFor(model => model.NewRecord.EndDate, new { @class = "form-label" })
                                @Html.TextBoxFor(model => model.NewRecord.EndDate, "{0:yyyy-MM-ddTHH:mm}", new { @type = "datetime-local", @class = "form-control flatpickr-datetime" })
                                @Html.ValidationMessageFor(model => model.NewRecord.EndDate, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>

                    <div class="form-check mb-3">
                        @Html.CheckBoxFor(model => model.NewRecord.IsManual, new { @class = "form-check-input" })
                        @Html.LabelFor(model => model.NewRecord.IsManual, new { @class = "form-check-label" })
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="btnCreateNewTrack">Create</button>
                </div>
            }
        </div>
    </div>
</div>

<!-- Download Modal -->
<div class="modal fade" id="downloadModal" tabindex="-1" aria-labelledby="downloadModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="downloadModalLabel"><i class="fa fa-download me-2"></i>Download Report</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            @using (Html.BeginForm("DownloadReport", "TimeTracking", FormMethod.Post, new { id = "downloadReportForm" }))
            {
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="alert alert-info" role="alert">
                        <i class="fa fa-info-circle me-2"></i>Select a date range for the report.
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="form-group">
                                @Html.Label("StartDate", "Start Date", new { @class = "form-label" })*
                                @Html.TextBox("StartDate", "", new { @type = "datetime-local", @class = "form-control flatpickr-datetime", @id = "downloadStartDate" })
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                @Html.Label("EndDate", "End Date", new { @class = "form-label" })
                                @Html.TextBox("EndDate", "", new { @type = "datetime-local", @class = "form-control flatpickr-datetime", @id = "downloadEndDate" })
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success" id="btnDownloadReport">Download</button>
                </div>
            }
        </div>
    </div>
</div>

@section scripts{
    <script src="~/Scripts/TimeTracking.js"></script>
}

