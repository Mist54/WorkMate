@model WorkMate.ViewModels.TimeTrackingListViewModel
@{
    ViewBag.Title = "Time Tracking";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center bg-dark">
                    <h3 class="my-0 text-white">Time Tracking</h3>
                    <button type="button" class="btn btn-info" data-bs-toggle="modal" data-bs-target="#createModal">
                        <i class="fa fa-plus-circle mx-2"></i>Create New Time Track
                    </button>
                </div>
                <div class="card-body">
                    @if (Model.TaskTimeEntries != null && Model.TaskTimeEntries.Any())
                    {
                        <p class="text-center text-muted">A list of records would be displayed here.</p>
                    }
                    else
                    {
                        <div class="alert alert-warning text-center" role="alert">
                            <i class="fa fa-warning mx-2"></i>No records found. Please add a record before continuing.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Create Modal -->
<div class="modal fade" id="createModal" tabindex="-1" aria-labelledby="createModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="createModalLabel"><i class="fa fa-plus-circle me-2"></i>Add New Track</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            @using (Html.BeginForm("Create", "TimeTracking", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="alert alert-info" role="alert">
                        <i class="fa fa-info-circle me-2"></i>Fields marked with an asterisk (*) are required.
                    </div>
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                    @Html.HiddenFor(model => model.NewRecord.Id)
                    @Html.HiddenFor(model => model.NewRecord.UserId)
                    @Html.HiddenFor(model => model.NewRecord.TaskName)

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="form-group">
                                @Html.LabelFor(model => model.NewRecord.TaskId, new { @class = "form-label" })*
                                @Html.DropDownListFor(model => model.NewRecord.TaskId, Model.DdlTasks, new { @class = " form-select select2" })
                                @Html.ValidationMessageFor(model => model.NewRecord.TaskId, "", new { @class = "text-danger" })
                                <small class="form-text text-muted">Use Select2 to search and select your task.</small>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                @Html.LabelFor(model => model.NewRecord.Status, new { @class = "form-label" })*
                                @Html.EnumDropDownListFor(model => model.NewRecord.Status, new { @class = "form-control" })
                                @Html.ValidationMessageFor(model => model.NewRecord.Status, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-12">
                            <div class="form-group">
                                @Html.LabelFor(model => model.NewRecord.Description, new { @class = "form-label" })*
                                @Html.TextAreaFor(model => model.NewRecord.Description, new { @class = "form-control", rows = 4, placeholder = "Describe your work here..." })
                                @Html.ValidationMessageFor(model => model.NewRecord.Description, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="form-group">
                                @Html.LabelFor(model => model.NewRecord.StartDate, new { @class = "form-label" })*
                                @Html.TextBoxFor(model => model.NewRecord.StartDate, "{0:yyyy-MM-ddTHH:mm}", new { @type = "datetime-local", @class = "form-control flatpickr-datetime" })
                                @Html.ValidationMessageFor(model => model.NewRecord.StartDate, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                @Html.LabelFor(model => model.NewRecord.EndDate, new { @class = "form-label" })
                                @Html.TextBoxFor(model => model.NewRecord.EndDate, "{0:yyyy-MM-ddTHH:mm}", new { @type = "datetime-local", @class = "form-control flatpickr-datetime" })
                                @Html.ValidationMessageFor(model => model.NewRecord.EndDate, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>

                    <div class="form-check mb-3">
                        @Html.CheckBoxFor(model => model.NewRecord.IsManual, new { @class = "form-check-input" })
                        @Html.LabelFor(model => model.NewRecord.IsManual, new { @class = "form-check-label" })
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create</button>
                </div>
            }
        </div>
    </div>
</div>
@section scripts{
    <script src="~/Scripts/TimeTracking.js"></script>
   
}

