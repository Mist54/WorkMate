@model WorkMate.ViewModels.TimeTrackingListViewModel
@{
    ViewBag.Title = "Time Tracking";
}
<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-md-12">
            <h4>Welcome, @ViewBag.Username!</h4>
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center bg-dark">
                    <h3 class="my-0 text-white">Time Tracking</h3>
                    <button type="button" class="btn btn-info" data-bs-toggle="modal" data-bs-target="#createModal">
                        <i class="fa fa-plus-circle mx-2"></i>Create New Time Track
                    </button>
                </div>
                <div class="card shadow-sm p-3">
                    <div class="card-header border-0 pb-0 bg-white">
                        <div class="row g-3 align-items-center">
                            <div class="col-lg-6">
                                <div class="input-group">
                                    @Html.TextBox("SearchText", null, new { @class = "form-control", placeholder = "Search...", type = "search", aria_label = "Search" })
                                    <button class="btn btn-primary" type="submit">
                                        <i class="fa fa-search me-2"></i>Search
                                    </button>
                                </div>
                            </div>
                            <div class="col-lg-6 d-flex justify-content-lg-end mt-3 mt-lg-0">
                                <span class="me-3 text-muted fw-bold">Filter:</span>
                                <div class="form-check form-check-inline">
                                    @Html.RadioButton("filterOptions", "option1", false, new { @class = "form-check-input", id = "option1" })
                                    <label class="form-check-label text-nowrap" for="option1">Option 1</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    @Html.RadioButton("filterOptions", "option2", false, new { @class = "form-check-input", id = "option2" })
                                    <label class="form-check-label text-nowrap" for="option2">Option 2</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    @Html.RadioButton("filterOptions", "option3", false, new { @class = "form-check-input", id = "option3" })
                                    <label class="form-check-label text-nowrap" for="option3">Option 3</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr class="my-3" />

                    <div class="card-body pt-0">
                        @{
                            if (Model.TaskTimeEntries != null && Model.TaskTimeEntries.Any())
                            {
                                foreach (var item in Model.TaskTimeEntries)
                                {
                                    <div class="row g-3 align-items-center mb-3">
                                        <div class="col-lg-4">
                                            @Html.TextBoxFor(m => item.Description, new { @class = "form-control", placeholder = "What are you working on?" })
                                        </div>
                                        <div class="col-lg-3">
                                            @Html.EnumDropDownListFor(m => item.Status, new { @class = "form-select", id = "ddlStatus_" + item.Id })
                                        </div>
                                        <div class="col-lg-3">
                                            @Html.DropDownListFor(m => item.TaskId, Model.DdlTasks, "Select Task", new { @class = "form-select select2", id = "ddlTask_" + item.Id })
                                        </div>
                                        <div class="col-lg-2 d-flex align-items-center justify-content-between">
                                            <div class="d-flex align-items-center me-3">
                                                <label id="Timer_@item.Id" class="h6 mb-0 fw-bold text-primary">00:00:00</label>
                                            </div>
                                            <div class="d-flex gap-2">
                                                <button class="btn btn-warning btn-sm d-block">Start</button>
                                                <button class="btn btn-danger btn-sm d-none">Stop</button>
                                                <button class="btn btn-info btn-sm text-white"><i class="fa fa-edit"></i></button>
                                                <button class="btn btn-danger btn-sm"><i class="fa fa-trash"></i></button>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <h6 class="alert alert-warning">No time records. Create new </h6>
                            }


                        }


                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- Create Modal -->
<div class="modal fade" id="createModal" tabindex="-1" aria-labelledby="createModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="createModalLabel"><i class="fa fa-plus-circle me-2"></i>Add New Track</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            @using (Html.BeginForm("Create", "TimeTracking", FormMethod.Post, new { id = "timeTrackingForm" }))
            {
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="alert alert-info" role="alert">
                        <i class="fa fa-info-circle me-2"></i>Fields marked with an asterisk (*) are required.
                    </div>
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                    @Html.HiddenFor(model => model.NewRecord.Id)
                    @Html.HiddenFor(model => model.NewRecord.UserId)
                    @Html.HiddenFor(model => model.NewRecord.TaskName)

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="form-group">
                                @Html.LabelFor(model => model.NewRecord.TaskId, new { @class = "form-label" })*
                                @Html.DropDownListFor(model => model.NewRecord.TaskId, Model.DdlTasks, new { @class = " form-select select2" })
                                @Html.ValidationMessageFor(model => model.NewRecord.TaskId, "", new { @class = "text-danger" })
                                <small class="form-text text-muted">Use Select2 to search and select your task.</small>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                @Html.LabelFor(model => model.NewRecord.Status, new { @class = "form-label" })*
                                @Html.EnumDropDownListFor(model => model.NewRecord.Status, new { @class = "form-select select2" })
                                @Html.ValidationMessageFor(model => model.NewRecord.Status, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-12">
                            <div class="form-group">
                                @Html.LabelFor(model => model.NewRecord.Description, new { @class = "form-label" })*
                                @Html.TextAreaFor(model => model.NewRecord.Description, new { @class = "form-control", rows = 4, placeholder = "Describe your work here..." })
                                @Html.ValidationMessageFor(model => model.NewRecord.Description, "", new { @class = "text-danger" })
                                <div class="invalid-feedback" id="descError"></div>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="form-group">
                                @Html.LabelFor(model => model.NewRecord.StartDate, new { @class = "form-label" })*
                                @Html.TextBoxFor(model => model.NewRecord.StartDate, "{0:yyyy-MM-ddTHH:mm}", new { @type = "datetime-local", @class = "form-control flatpickr-datetime" })
                                @Html.ValidationMessageFor(model => model.NewRecord.StartDate, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                @Html.LabelFor(model => model.NewRecord.EndDate, new { @class = "form-label" })
                                @Html.TextBoxFor(model => model.NewRecord.EndDate, "{0:yyyy-MM-ddTHH:mm}", new { @type = "datetime-local", @class = "form-control flatpickr-datetime" })
                                @Html.ValidationMessageFor(model => model.NewRecord.EndDate, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>

                    <div class="form-check mb-3">
                        @Html.CheckBoxFor(model => model.NewRecord.IsManual, new { @class = "form-check-input" })
                        @Html.LabelFor(model => model.NewRecord.IsManual, new { @class = "form-check-label" })
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="btnCreateNewTrack">Create</button>
                </div>
            }
        </div>
    </div>
</div>
@section scripts{
    <script src="~/Scripts/TimeTracking.js"></script>
}

