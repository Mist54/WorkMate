@model WorkMate.ViewModels.AppRoleViewModel

@{
    ViewBag.Title = "Delete Role";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            @using (Html.BeginForm("RoleDelete", "Admin", FormMethod.Post))
            {
                <div class="card">
                    <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center">
                        <h4>Delete Role</h4>
                        <a href="@Url.Action("RoleIndex", "Admin")" class="btn btn-sm btn-dark">
                            <i class="fa fa-arrow-left"></i> Back to List
                        </a>
                    </div>
                    <div class="card-body">
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m => m.Id)

                        <p class="text-danger fw-bold mb-3">Are you sure you want to delete this role?</p>
                        <p class="small text-muted mb-4">
                            All permissions and users assigned to this role will be affected.
                        </p>

                        <div class="form-group mb-3">
                            @Html.Label("Role Name", new { @class = "form-label" })
                            <input type="text" class="form-control bg-light text-muted" value="@Model.Name" readonly />
                        </div>

                        <div class="form-group mb-3">
                            @Html.Label("Description", new { @class = "form-label" })
                            <textarea class="form-control bg-light text-muted" rows="3" readonly>@Model.Description</textarea>
                        </div>

                    </div>
                    <div class="card-footer">
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-danger mt-3">
                                Delete Role
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <!-- Optional scripts if needed -->
}
