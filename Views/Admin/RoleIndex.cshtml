@model WorkMate.ViewModels.AppRoleViewModelList

<div class="container">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center bg-primary text-white">
                    <h4>Role List</h4>
                    <a href="@Url.Action("RoleCreate", "Admin")" class="btn btn-sm btn-dark">
                        <i class="fa fa-plus me-1"></i> Create new Role
                    </a>
                </div>
                <div class="card-body">
                    @if (Model != null && Model.RolesList.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead>
                                    <tr class="table-success">
                                        <th>ID</th>
                                        <th>Rolename</th>
                                        <th class="col-md-3">Description</th>
                                        <th class="col-md-3">Created by</th>
                                        <th class="col-md-3">Created date</th>
                                        <th class="text-end">Action</th>
                                        
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var Role in Model.RolesList)
                                    {
                                        <tr>
                                            <td>@Role.Id</td>
                                            <td>@Role.Name</td>
                                            <td>@Role.Description</td>
                                            <td>
                                                @Role.CreatedBy
                                            </td>
                                            <td>
                                                @Role.CreatedDate
                                            </td>
                                            <td class="text-end">
                                                <a href="@Url.Action("RoleEdit", "Admin", new { id = Role.Id })" class="btn btn-sm btn-primary">
                                                    <i class="fa fa-edit"></i> Edit
                                                </a>

                                                <a href="@Url.Action("RoleDelete", "Admin", new { id = Role.Id })" class="btn btn-sm btn-danger">
                                                    <i class="fa fa-trash"></i> Delete
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info" role="alert">
                            No Roles found.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
