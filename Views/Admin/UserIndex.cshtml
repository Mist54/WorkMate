@model WorkMate.ViewModels.AppUserViewModalList

<div class="container">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center bg-primary text-white">
                    <h4>User List</h4>
                    <a href="@Url.Action("UserCreate", "Admin")" class="btn btn-sm btn-dark">
                        <i class="fa fa-plus me-1"></i> Create new user
                    </a>
                </div>
                <div class="card-body">
                    @if (Model != null && Model.UserList.Any())
                    {
                       <div class="table-responsive">
                           <table class="table table-striped table-hover">
                               <thead>
                                   <tr class="table-success">
                                       <th>ID</th>
                                       <th>Username</th>
                                       <th class="col-md-3">Email</th>
                                       <th class="col-md-3">Designation</th>
                                       <th class="col-md-3 text-center">Actions</th>
                                   </tr>
                               </thead>
                               <tbody>
                                   @foreach (var user in Model.UserList)
                                   {
                                       <tr>
                                           <td>@user.Id</td>
                                           <td>@user.UserName</td>
                                           <td>@user.Email</td>
                                           <td>
                                               @(!string.IsNullOrWhiteSpace(user.Designation) ? user.Designation : "Not assigned")
                                           </td>
                                           <td class="text-end">
                                               <a href="@Url.Action("UserEdit", "Admin", new { id = user.Id })" class="btn btn-sm btn-primary">
                                                   <i class="fa fa-edit"></i> Edit
                                               </a>
                                               <a href="@Url.Action("Details", "Admin", new { id = user.Id })" class="btn btn-sm btn-info">
                                                   <i class="fa fa-eye"></i> View
                                               </a>
                                               <a href="@Url.Action("Delete", "Admin", new { id = user.Id })" class="btn btn-sm btn-danger">
                                                   <i class="fa fa-trash"></i> Delete
                                               </a>
                                           </td>
                                       </tr>
                                   }
                               </tbody>
                           </table>
                       </div>
                    }
                    else
                    {
                        <div class="alert alert-info" role="alert">
                            No users found.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>