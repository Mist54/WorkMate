@model WorkMate.ViewModels.TestCaseViewModel
<div class="card">
    <div class="card-header  bg-info text-center py-3 rounded-top-3">
        <h5 class="card-title text-center mb-0">Test Case List</h5>
    </div>
    <div class="card-body shadow">
        <table class="table table-hover mb-0 slim-scrollbar">
            <thead class="table-light">
                <tr>
                    <th>Testcase name</th>
                    <th>Pre-conditions</th>
                    <th>Steps</th>
                    <th>Expected result</th>
                    <th>Status</th>
                    <th>Edit</th>
                    <th>Delete</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.AllTestCases != null && Model.AllTestCases.Any())
                {
                    foreach (var testCase in Model.AllTestCases)
                    {
                        <tr>
                            <td>@testCase.TestCaseName</td>
                            <td>@testCase.Preconditions</td>
                            <td>@Html.Raw(testCase.Steps)</td>
                            <td>@testCase.ExpectedResult</td>
                            <td>
                                @{
                                    string badgeClass = "bg-secondary";
                                    switch (testCase.TestCaseStatus)
                                    {
                                        case WorkMate.Models.TestCaseStatus.Passed:
                                            badgeClass = "bg-success";
                                            break;
                                        case WorkMate.Models.TestCaseStatus.Failed:
                                            badgeClass = "bg-danger";
                                            break;
                                        case WorkMate.Models.TestCaseStatus.Other:
                                            badgeClass = "bg-warning text-dark";
                                            break;
                                    }
                                }
                                <span class="badge @badgeClass">@testCase.TestCaseStatus</span>
                            </td>
                            <td>
                                <a href="@Url.Action("Edit", "TestCase", new { id = WorkMate.Helpers.Encryptor.EncryptUrlSafe(testCase.TestCaseId.ToString()) })"
                                   class="btn btn-primary btn-sm me-2" title="Edit">
                                    <i class="fa fa-edit"></i>
                                </a>
                            </td>
                            <td>
                                <button class="btn btn-danger btn-sm me-2"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteModal"
                                        onclick="setDeleteId(@testCase.TestCaseId)">
                                    <i class="fa fa-trash"></i>
                                </button>
                            </td>


                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-warning text-muted">
                            No test cases found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>



<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteConfirmationModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger">
                <h5 class="modal-title text-white" id="deleteModalLabel">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            @using (Html.BeginForm("Delete", "Testcase", FormMethod.Post, new { id = "deleteForm" }))
            {
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <p>Are you sure you want to delete this testcase?</p>

                    @* Hidden field to pass the ID of the item *@
                    @Html.Hidden("id", "", new { id = "hdnTestcaseIdForDelete" })
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger" onclick="confirmAndDelete()">Delete</button>
                </div>
            }
        </div>
    </div>
</div>
