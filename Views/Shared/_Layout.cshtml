<!DOCTYPE html>
<html data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Workmate your IT work partner</title>

    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/plugins/select2.css" rel="stylesheet" />
    <link href="~/Content/plugins/iziToast.css" rel="stylesheet" />
    <link href="~/Content/plugins/flatdatepicker.css" rel="stylesheet" />
    <link href="~/Content/font-awesome.css" rel="stylesheet" />
    <link href="~/Content/Site.css" rel="stylesheet" />
    <style>
        /* Subtle dropdown active state using Bootstrap classes only */
        .nav-link.dropdown-active {
            background-color: rgba(255, 255, 255, 0.1) !important;
            border-radius: 0.375rem;
        }

        /* Select2 Dark Mode Styles */
        [data-bs-theme="dark"] .select2-container--default .select2-selection--single {
            background-color: var(--bs-dark);
            border: 1px solid var(--bs-border-color);
            color: var(--bs-body-color);
        }

            [data-bs-theme="dark"] .select2-container--default .select2-selection--single .select2-selection__rendered {
                color: var(--bs-body-color);
            }

        [data-bs-theme="dark"] .select2-dropdown {
            background-color: var(--bs-dark);
            border: 1px solid var(--bs-border-color);
        }

        [data-bs-theme="dark"] .select2-container--default .select2-results__option {
            background-color: var(--bs-dark);
            color: var(--bs-body-color);
        }

        [data-bs-theme="dark"] .select2-container--default .select2-results__option--highlighted {
            background-color: var(--bs-primary);
            color: var(--bs-white);
        }

        [data-bs-theme="dark"] .select2-container--default .select2-selection--single .select2-selection__arrow b {
            border-color: var(--bs-body-color) transparent transparent transparent;
        }

        /* Default (light) */
        .flatpickr-calendar {
            /* light theme overrides already in flatdatepicker.css */
        }

        /* Dark mode */
        body.dark-mode .flatpickr-calendar {
            /* dark theme overrides from flatdatepickerdark.css */
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold fs-4" href="#">
                <i class="fa fa-briefcase me-2"></i>Work<span class="text-warning">mate</span>
            </a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link fw-semibold nav-menu-item active" data-nav="home" aria-current="page" href="@Url.Action("Index","Home")">
                            <i class="fa fa-home me-1"></i>Home
                        </a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle fw-semibold nav-menu-item" data-nav="testerdev" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fa fa-code me-1"></i>Tester X Dev
                        </a>
                        <ul class="dropdown-menu shadow border-0" aria-labelledby="navbarDropdown">
                            <li>
                                <a class="dropdown-item py-2 nav-submenu-item" data-nav="testcases" href="@Url.Action("Index","Testcase")">
                                    <i class="fa fa-dashboard me-2 text-primary"></i>Testcases dashboard
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item py-2 nav-submenu-item" data-nav="tasks" href="@Url.Action("Index","Task")">
                                    <i class="fa fa-tasks me-2 text-primary"></i>Tasks list
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item py-2 nav-submenu-item" data-nav="createtestcase" href="@Url.Action("Create","Testcase")">
                                    <i class="fa fa-check-circle me-2 text-primary"></i>Create Testcase
                                </a>
                            </li>
                        </ul>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link fw-semibold nav-menu-item" data-nav="Track Time" aria-current="page" href="@Url.Action("Index","TimeTracking")">
                            <i class="fa fa-clock-o me-1"></i>Track Time
                        </a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle fw-semibold nav-menu-item" data-nav="testerdev" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fa fa-user-circle-o me-1"></i>Admin pages
                        </a>
                        <ul class="dropdown-menu shadow border-0" aria-labelledby="navbarDropdown">
                            <li>
                                <a class="dropdown-item py-2 nav-submenu-item" data-nav="tasks" href="@Url.Action("UserIndex","Admin")">
                                    <i class="fa fa-users me-2 text-primary"></i>System users
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item py-2 nav-submenu-item" data-nav="testcases" href="@Url.Action("RoleIndex","Admin")">
                                    <i class="fa fa-gavel me-2 text-warning"></i>System roles
                                </a>
                            </li>
                        </ul>
                    </li>

                </ul>
                <div class="navbar-nav">
                    <div class="nav-item">
                        <a class="text-white ms-auto nav-link" data-nav="Track Time" aria-current="page">
                            <b>Welcome - @HttpContext.Current.User.Identity.Name..!</b>
                        </a>
                    </div>
                    <div class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fa fa-user-circle fs-5 me-1"></i>Profile
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                            <li><a class="dropdown-item" href="#"><i class="fa fa-cog me-2"></i>Settings</a></li>
                            <li>
                                @using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "logoutForm" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item">
                                        <i class="fa fa-sign-out me-2"></i> Logout
                                    </button>
                                }
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <!-- Dark Mode Toggle Button -->
                            <li>
                                <a class="dropdown-item d-flex align-items-center" href="#" id="themeToggle" role="button">
                                    <i class="fa fa-moon-o me-2" id="themeIcon"></i>
                                    <span id="themeText">Dark Mode</span>
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <div class="row"><div class="col-12">&nbsp;</div></div>

    <div class="container-fluid body-content flex-grow-1">
        @RenderBody()
        <hr />
    </div>

    <footer class="bg-secondary-subtle mt-auto">
        <div class="container-fluid">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <p class="mb-0">
                        <i class="fa fa-copyright me-1 small"></i>
                        <small id="currentYear"></small> - WORKMATE
                    </p>
                </div>
            </div>
        </div>
    </footer>


    <!--Loader section-->
    <div id="fullPageLoader" class="d-flex d-none flex-column justify-content-center align-items-center position-fixed top-0 start-0 w-100 h-100 bg-dark bg-opacity-75 text-white" style="z-index:1050;">
        <div class="spinner-grow text-light mb-3" role="status" style="width: 4rem; height: 4rem;">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="lead fw-bold">Loading...</p>
    </div>

    <script src="~/Scripts/jquery-3.7.1.min.js"></script>
    <script src="~/Scripts/bootstrap.bundle.min.js"></script>
    <script src="~/Scripts/plugins/select2.js"></script>
    <script src="~/Scripts/plugins/iziToast.js"></script>
    <script src="~/Scripts/plugins/flatdatepicker.js"></script>

    @RenderSection("scripts", required: false)
    <script>
        $(document).ready(function () {
            // Initialize Select2 plugin
            $('.select2').select2({
                width: '100%',
                placeholder: 'Select an option',
                allowClear: false
            });
            // Reinitialize Select2 when theme changes to apply dark mode styles
            $(document).on('themeChanged', function () {
                $('.select2').each(function () {
                    if ($(this).hasClass('select2-hidden-accessible')) {
                        $(this).select2('destroy');
                    }
                }).select2({
                    width: '100%',
                    placeholder: 'Select an option',
                    allowClear: true
                });
            });
            document.getElementById('currentYear').textContent = new Date().getFullYear();
            // Initialize theme on page load
            initializeTheme();
            // Initialize active navigation state
            initializeActiveNav();

            // Theme toggle functionality
            $('#themeToggle').click(function () {
                toggleTheme();
            });

            // Navigation active state functionality
            $('.nav-menu-item, .nav-submenu-item').click(function (e) {
                var clickedItem = $(this);
                var navType = clickedItem.data('nav');

                // Store the active nav state
                localStorage.setItem('activeNav', navType);

                // Update active states
                setActiveNavState(navType);
            });

            // Dropdown show/hide events for subtle active states
            $('.dropdown').on('show.bs.dropdown', function () {
                var dropdownToggle = $(this).find('.nav-menu-item');
                dropdownToggle.addClass('dropdown-active');
            });

            $('.dropdown').on('hide.bs.dropdown', function () {
                var dropdownToggle = $(this).find('.nav-menu-item');
                var activeNav = localStorage.getItem('activeNav');

                // Only remove dropdown-active if this dropdown doesn't contain the active item
                if (activeNav !== 'tasks' && activeNav !== 'testcases' && activeNav !== 'createtestcase') {
                    dropdownToggle.removeClass('dropdown-active');
                }
            });


            //Universal declaration of the function  window.toggleBootstrapModal = function(modalId, action) { ...}
            //here if we write it as window.functionname it will be explicitly set as global
            window.toggleBootstrapModal = function (modalId, action) {
                var modalElement = document.getElementById(modalId);
                if (modalElement) {
                    var bootstrapModal = bootstrap.Modal.getInstance(modalElement) //Bootstrap 5+ interacting with modals

                    /*An instance of the Bootstrap Modal JavaScript class needs to be created to
                     * give a specific HTML element(identified by its ID) the interactive behavior of a Bootstrap modal,
                     * allowing you to programmatically activate(show) or deactivate(hide) it*/
                    if (!bootstrapModal) {
                        bootstrapModal = new bootstrap.Modal(modalElement);
                    }

                    if (bootstrapModal) {
                        if (action == 'show') {
                            bootstrapModal.show();
                        }
                        else if (action == 'hide') {
                            bootstrapModal.hide();
                        }
                    }

                }
                else {
                    console.error("Model Could not be found.");
                }

            }

        });

        // Function to initialize theme based on stored preference
        function initializeTheme() {
            var savedTheme = localStorage.getItem('theme') || 'light';
            setTheme(savedTheme);
        }
        // Function to toggle between light and dark themes
        function toggleTheme() {
            var currentTheme = document.documentElement.getAttribute('data-bs-theme');
            var newTheme = currentTheme === 'dark' ? 'light' : 'dark';
            setTheme(newTheme);
        }
        // Function to set theme
        function setTheme(theme) {
            document.documentElement.setAttribute('data-bs-theme', theme);
            localStorage.setItem('theme', theme);

            var themeIcon = document.getElementById('themeIcon');
            var themeText = document.getElementById('themeText');
            if (theme === 'dark') {
                themeIcon.className = 'fa fa-sun-o me-2';
                themeText.textContent = 'Light Mode';
            } else {
                themeIcon.className = 'fa fa-moon-o me-2';
                themeText.textContent = 'Dark Mode';
            }
            $(document).trigger('themeChanged');
        }

        // Function to set active navigation state
        function setActiveNavState(navType) {
            // Remove active and dropdown-active class from all items
            $('.nav-menu-item').removeClass('active dropdown-active');
            $('.nav-submenu-item').removeClass('active');

            // Set active based on navType
            if (navType === 'tasks' || navType === 'testcases' || navType === 'createtestcase') {
                // Activate parent dropdown
                $('.nav-menu-item[data-nav="testerdev"]').addClass('active dropdown-active');
                // Activate specific submenu item
                $('.nav-submenu-item[data-nav="' + navType + '"]').addClass('active');
            } else {
                // Activate regular menu item
                $('.nav-menu-item[data-nav="' + navType + '"]').addClass('active');
            }
        }

        // Function to initialize active navigation state
        function initializeActiveNav() {
            // Get current page URL
            var currentUrl = window.location.pathname.toLowerCase();
            var detectedNav = null;

            // Detect nav based on current URL
            if (currentUrl.includes('/testcase/index')) {
                detectedNav = 'testcases';
            } else if (currentUrl.includes('/task/index')) {
                detectedNav = 'tasks';
            } else if (currentUrl.includes('/testcase/create')) {
                detectedNav = 'createtestcase';
            } else if (currentUrl.includes('/timetracking/index')) {
                detectedNav = 'Track Time';
            } else if (currentUrl.includes('/admin/userindex')) {
                detectedNav = 'tasks'; // Admin users submenu
            } else if (currentUrl.includes('/admin/roleindex')) {
                detectedNav = 'testcases'; // Admin roles submenu
            } else if (currentUrl.includes('/home/index') || currentUrl === '/' || currentUrl === '') {
                detectedNav = 'home';
            }

            // If we detected a nav from URL, use it; otherwise fall back to localStorage or default to 'home'
            var activeNav = detectedNav || localStorage.getItem('activeNav') || 'home';

            // Update localStorage with detected nav
            if (detectedNav) {
                localStorage.setItem('activeNav', activeNav);
            }

            // Set the active state
            setActiveNavState(activeNav);
        }
        // Function to display iziToast notifications
        function showToast(type, message, title = '') {
            iziToast[type]({
                title: title,
                message: message,
                position: 'topRight',
                timeout: 5000,
                progressBar: true,
                transitionIn: 'fadeInLeft',
                transitionOut: 'fadeOutRight'
            });
        }

        //Function to show the loader
        function showLoader() {
            $('#fullPageLoader').removeClass('d-none');
        }

        // Function to hide the loader
        function hideLoader() {
            $('#fullPageLoader').addClass('d-none');
        }

        document.addEventListener('DOMContentLoaded', function () {
            var toastMessage = '@TempData["ToastMessage"]';
            var toastType = '@TempData["ToastType"]';
            var toastTitle = '@TempData["ToastTitle"]';

            // Only show toast if a message and type are provided
            if (toastMessage && toastType) {
                showToast(toastType.toLowerCase(), toastMessage, toastTitle);
            }

        });
    </script>
</body>
</html>